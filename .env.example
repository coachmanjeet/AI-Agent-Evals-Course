# Copy to .env and fill in. Never commit .env.
# You only need ONE model provider key, plus LangSmith for tracing (Week 1+).

# Model providers (pick one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# LangSmith tracing & datasets (used from Week 1)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-evals-course
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # only if self-hosting

# Braintrust (Weeks 2+ evals, tracing, judge proxy — free course credit at braintrust.dev)
BRAINTRUST_API_KEY=

# Verify: after `make setup`, run `make agent` (no key needed for the demo
# reply). Then run one traced input and confirm the trace appears in your
# LangSmith project (Path A) or the Trace Viewer (Path B, fully keyless).
